<section class="section promo-mosaic">
  <div class="page-width">
    <div class="section__header">
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>

    <div class="promo-mosaic__grid">
      {%- for block in section.blocks -%}
        <article class="promo-mosaic__tile promo-mosaic__tile--{{ block.settings.size }}" {{ block.shopify_attributes }}>
          <div class="promo-mosaic__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400, 650, 900, 1200, 1600', loading: 'lazy', sizes: '(min-width: 750px) 33vw, 100vw' }}
            {%- endif -%}
          </div>
          <div class="promo-mosaic__content">
            {%- if block.settings.eyebrow != blank -%}
              <p class="eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h3>{{ block.settings.heading }}</h3>
            {%- if block.settings.text != blank -%}
              <p>{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="button button--secondary" href="{{ block.settings.link }}">{{ block.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promo mosaic",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Merchandising moments"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Tile size",
          "default": "small",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "large", "label": "Large" }
          ]
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Drop"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Signature tailoring"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Use this block for product stories, collection pushes, or conversion campaigns."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Discover"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Promo mosaic",
      "blocks": [
        { "type": "tile", "settings": { "size": "large" } },
        { "type": "tile", "settings": { "size": "small" } },
        { "type": "tile", "settings": { "size": "small" } }
      ]
    }
  ]
}
{% endschema %}
