<section class="section flowbit-list-collections">
  <div class="flowbit-list-collections__header">
    <p>Collections</p>
    <h1>Collections</h1>
  </div>

  <div class="flowbit-list-collections__grid">
    {%- for collection in collections -%}
      {%- unless collection.handle == 'frontpage' -%}
        {%- liquid
          assign fallback_image = ''
          case collection.handle
            when 'bottoms'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/JEANS_FRONT_c2750e11-3f2e-417b-913a-fba25496a8d7.jpg?v=1771419414&width=1600'
            when 'day2day'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/PINK_BOTTOMS_FRONT_73e58a0c-3d9a-45f0-9cbd-3c1801f77d14.jpg?v=1771419403&width=1600'
            when 'denim'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/SCRATCH_JEANS_FRONT.jpg?v=1771419406&width=1600'
            when 'outwear'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/BigBombaFrontResized3.png?v=1771419403&width=1600'
            when 'sale'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/Artboard17_7aada448-cb50-4922-be37-e7b94d27c0be.png?v=1771419382&width=1600'
            when 'sweats'
              assign fallback_image = '//demo-1-9580.myshopify.com/cdn/shop/files/PINK_BOTTOMS_FRONT_73e58a0c-3d9a-45f0-9cbd-3c1801f77d14.jpg?v=1771419403&width=1600'
          endcase
        -%}

        <article class="flowbit-collection-card" data-premium-scroll>
          <a class="flowbit-collection-card__link" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}"></a>
          <div class="flowbit-collection-card__media" data-premium-scroll-media>
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 1600 | image_tag: widths: '450, 750, 1100, 1600', loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw' }}
            {%- elsif collection.products.first.featured_media -%}
              {{ collection.products.first.featured_media | image_url: width: 1600 | image_tag: widths: '450, 750, 1100, 1600', loading: 'lazy', sizes: '(min-width: 990px) 33vw, 100vw' }}
            {%- elsif fallback_image != blank -%}
              <img src="{{ fallback_image }}" alt="{{ collection.title | escape }}" width="1600" height="2000" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="flowbit-collection-card__content">
            <h2>{{ collection.title }}</h2>
            <span>{{ collection.products_count }} products</span>
          </div>
        </article>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": []
}
{% endschema %}
