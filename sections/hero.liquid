<section class="hero hero--{{ section.settings.content_position }}" style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}; --hero-min-height: {{ section.settings.min_height }}vh;">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', loading: 'eager', fetchpriority: 'high', sizes: '100vw' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    <div class="hero__content-inner">
      {%- if section.settings.kicker != blank -%}
        <div class="hero__kicker">{{ section.settings.kicker }}</div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="hero__buttons">
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank -%}
          <a class="button button--secondary hero__secondary-button" href="{{ section.settings.secondary_button_link }}">{{ section.settings.secondary_button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.side_note != blank -%}
    <div class="hero__side-note">{{ section.settings.side_note }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fallback image" },
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "range", "id": "min_height", "min": 60, "max": 100, "step": 5, "unit": "vh", "label": "Minimum height", "default": 90 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Overlay opacity", "default": 45 },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "bottom-left",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-center", "label": "Bottom center" }
      ]
    },
    { "type": "text", "id": "kicker", "label": "Top kicker", "default": "01 / New editorial drop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Modern essentials with an editorial edge" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Build a polished fashion storefront with immersive visuals, fast product discovery, and flexible merchandising." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop arrivals" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "Explore lookbook" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" },
    { "type": "text", "id": "side_note", "label": "Vertical side note", "default": "Campaign / 2026" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
