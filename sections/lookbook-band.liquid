<section class="lookbook-band">
  <div class="lookbook-band__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', loading: 'lazy', sizes: '100vw' }}
    {%- endif -%}
  </div>

  <div class="lookbook-band__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 class="lookbook-band__title">{{ section.settings.heading }}</h2>

    {%- if section.settings.text != blank -%}
      <p class="lookbook-band__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook band",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Campaign"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A cinematic layer for seasonal storytelling"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Use a strong campaign image here. The layout is designed for fashion drops, lookbooks, and collection launches."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View lookbook"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Lookbook band"
    }
  ]
}
{% endschema %}
