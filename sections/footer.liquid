<footer class="site-footer premium-footer">
  <div class="premium-footer__top page-width">
    <div class="premium-footer__brand">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <strong>{{ section.settings.heading | default: shop.name }}</strong>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <form class="premium-footer__newsletter" action="{{ routes.search_url }}" method="get">
      <label>
        <span>{{ section.settings.newsletter_label }}</span>
        <input type="email" placeholder="{{ section.settings.newsletter_placeholder }}">
      </label>
      <button class="button" type="button">{{ section.settings.newsletter_button }}</button>
    </form>
  </div>

  <div class="premium-footer__grid page-width">
    {%- if section.settings.menu != blank -%}
      <nav class="premium-footer__links" aria-label="{{ 'sections.footer.navigation' | t }}">
        <span>{{ section.settings.menu_heading }}</span>
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if section.settings.secondary_menu != blank -%}
      <nav class="premium-footer__links" aria-label="Footer secondary navigation">
        <span>{{ section.settings.secondary_menu_heading }}</span>
        {%- for link in section.settings.secondary_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <div class="premium-footer__links">
      <span>{{ section.settings.account_heading }}</span>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}">Account</a>
        <a href="{{ routes.account_login_url }}">Login</a>
        <a href="{{ routes.account_register_url }}">Sign up</a>
      {%- else -%}
        <a href="{{ routes.cart_url }}">Cart</a>
        <a href="{{ routes.all_products_collection_url }}">Shop all</a>
      {%- endif -%}
    </div>

    <div class="premium-footer__meta">
      <span>{{ section.settings.store_heading }}</span>
      <p>{{ section.settings.store_text }}</p>
    </div>
  </div>

  <div class="premium-footer__bottom page-width">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    <p>{{ section.settings.bottom_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Editorial commerce" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shopception" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A premium storefront experience built for modern fashion, lifestyle, and editorial commerce brands." },
    { "type": "text", "id": "newsletter_label", "label": "Newsletter label", "default": "Join the list" },
    { "type": "text", "id": "newsletter_placeholder", "label": "Newsletter placeholder", "default": "Email address" },
    { "type": "text", "id": "newsletter_button", "label": "Newsletter button", "default": "Subscribe" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" },
    { "type": "text", "id": "menu_heading", "label": "Menu heading", "default": "Shop" },
    { "type": "link_list", "id": "secondary_menu", "label": "Secondary menu" },
    { "type": "text", "id": "secondary_menu_heading", "label": "Secondary menu heading", "default": "Information" },
    { "type": "text", "id": "account_heading", "label": "Account heading", "default": "Account" },
    { "type": "text", "id": "store_heading", "label": "Store heading", "default": "Studio" },
    { "type": "textarea", "id": "store_text", "label": "Store text", "default": "Use this space for store location, contact details, shipping notes, or brand values." },
    { "type": "text", "id": "bottom_text", "label": "Bottom text", "default": "Designed for premium shopping experiences." }
  ]
}
{% endschema %}
